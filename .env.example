# LLM Provider Configuration
# Optional: Set your OpenAI API key or Gemini API key
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Twitter API v2 Configuration (Optional: for collecting live tweets)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Model Selection
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cache Configuration (enables zero-cost offline reproduction)
USE_CACHE=true
CACHE_DIR=cache

# Random Seed
RANDOM_SEED=42
